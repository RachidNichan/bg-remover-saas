# ==============================================================================
# AI Background Remover SaaS - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Backend Configuration
# ------------------------------------------------------------------------------
AI_BACKEND_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
REMBG_MODEL=u2net
MAX_IMAGE_SIZE_MB=15
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Firebase Server-Side Admin SDK Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=bg-remover-saas
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@bg-remover-saas.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY_ID=your_private_key_id_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ------------------------------------------------------------------------------
# 3. Firebase Web Client SDK Configuration (Auth & Firestore)
# ------------------------------------------------------------------------------
# Get these from Firebase Console -> Project Settings -> General -> Your apps -> Web app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bg-remover-saas
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=bg-remover-saas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=bg-remover-saas.firebasestorage.app
NEXT_PUBLIC_FIREBASE_API_KEY=your_web_api_key_here
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ------------------------------------------------------------------------------
# 4. SaaS Business Logic Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_FREE_CREDITS=3
NEXT_PUBLIC_APP_NAME="Remove Backgrounds Online"
NEXT_PUBLIC_APP_URL=https://removebackgrounds.online
